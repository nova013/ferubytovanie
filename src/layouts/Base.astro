---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import { photo } from '../data/photos';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.seo.title, description = site.seo.description } = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;

// Open Graph obrázok – hlavná fotografia budovy v pomere 1,91:1
const ogImage = await getImage({
  src: photo('main-building').src,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 82,
});
// Open Graph vyžaduje absolútnu adresu – bez nastavenej domény (SITE_URL) sa značka vynechá.
const ogImageUrl = Astro.site ? new URL(ogImage.src, Astro.site).toString() : undefined;

// Štruktúrované dáta – iba overené údaje o ubytovaní
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: site.name,
  description,
  url: canonical,
  telephone: site.phoneE164,
  email: site.email,
  image: ogImageUrl ? [ogImageUrl] : undefined,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Polianky 15',
    addressLocality: 'Bratislava',
    postalCode: '841 01',
    addressCountry: 'SK',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.latitude,
    longitude: site.geo.longitude,
  },
  hasMap: site.maps.placeUrl,
  numberOfRooms: site.facts.rooms,
  petsAllowed: false,
  priceRange: '10 € / noc / lôžko',
  currenciesAccepted: 'EUR',
  amenityFeature: [
    'Wi-Fi',
    'Parkovanie',
    'Práčky',
    'Spoločné kuchyne',
    'Spoločné kúpeľne',
    'Kamerový systém',
  ].map((name) => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
};
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#1f6b4e" />
    <meta name="format-detection" content="telephone=yes" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sk_SK" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={site.seo.ogImageAlt} />
          <meta name="twitter:image" content={ogImageUrl} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#obsah">Preskočiť na obsah</a>
    <Header />
    <slot />
    <Footer />
    <MobileCallBar />
  </body>
</html>
