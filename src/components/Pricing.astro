---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { site } from '../data/site';

const included = [
  'Wi‑Fi',
  'Používanie práčok',
  'Parkovanie pri budove',
  'Spoločné kuchyne a kúpeľne',
  'Bežné vybavenie ubytovania',
];
---

<section class="section section--alt pricing" id="cennik" aria-labelledby="cennik-nadpis">
  <div class="container">
    <SectionHead
      id="cennik-nadpis"
      eyebrow="Cenník"
      title="Jedna jasná cena"
      lead="Platíte za lôžko a noc. Všetko, čo k ubytovaniu potrebujete, je zahrnuté v cene."
      align="center"
    />

    <div class="price-card">
      <div class="price-card__price">
        <span class="price-card__label">Ubytovanie</span>
        <span class="price-card__value">{site.price.display}</span>
        <span class="price-card__unit">{site.price.unit}</span>
        <p class="price-card__hint">Cena platí za jedno lôžko na jednu noc.</p>
      </div>

      <div class="price-card__details">
        <h3>V cene je zahrnuté</h3>
        <ul class="check-list price-card__list">
          {
            included.map((item) => (
              <li>
                <span class="check-list__icon">
                  <Icon name="check" size={14} stroke={3} />
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>

        <p class="price-card__rule">
          <Icon name="ban" size={18} />
          <span>Domáce zvieratá nie sú povolené.</span>
        </p>

        <div class="price-card__actions">
          <a class="btn btn--primary btn--lg" href={site.phoneHref}>
            <Icon name="phone" size={20} />
            <span>Zavolať a overiť dostupnosť</span>
          </a>
          <a class="btn btn--secondary btn--lg" href={site.emailHref}>
            <Icon name="mail" size={20} />
            <span>Napísať e‑mail</span>
          </a>
        </div>
        <p class="price-card__contact">
          Dostupnosť lôžok vám najrýchlejšie potvrdíme telefonicky na čísle
          <a href={site.phoneHref}>{site.phoneDisplay}</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .price-card {
    display: grid;
    max-width: 960px;
    margin-inline: auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .price-card__price {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 0.2rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    background: var(--color-accent);
    color: #fff;
  }

  .price-card__label {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
  }

  .price-card__value {
    font-size: clamp(3.5rem, 3rem + 3vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .price-card__unit {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .price-card__hint {
    margin-top: 1rem;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.82);
  }

  .price-card__details {
    padding: clamp(1.25rem, 4vw, 2.75rem);
  }

  /* Na úzkych telefónoch sa text tlačidla zmestí do jedného riadku */
  @media (max-width: 479.98px) {
    .price-card__actions .btn {
      padding-inline: 0.9rem;
      font-size: 1rem;
    }
  }

  .price-card__details h3 {
    margin-bottom: 1rem;
  }

  .price-card__list {
    gap: 0.7rem;
  }

  .price-card__rule {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.5rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--color-surface-2);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .price-card__rule svg {
    flex: none;
    color: var(--color-text-muted);
  }

  .price-card__actions {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .price-card__contact {
    margin-top: 1rem;
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }

  .price-card__contact a {
    font-weight: 700;
    white-space: nowrap;
  }

  @media (min-width: 560px) {
    .price-card__actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 800px) {
    .price-card {
      grid-template-columns: minmax(260px, 0.85fr) minmax(0, 1.4fr);
    }

    .price-card__actions {
      grid-template-columns: 1fr;
    }
  }
</style>
