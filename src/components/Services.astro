---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { site } from '../data/site';
---

<section class="section services" id="sluzby" aria-labelledby="sluzby-nadpis">
  <div class="container">
    <SectionHead
      id="sluzby-nadpis"
      eyebrow="Služby v areáli"
      title="Služby priamo v našom areáli"
      lead="Počas pobytu môžete využiť služby priamo v našom areáli:"
    />

    <ul class="services__list">
      {
        site.services.map((service) => (
          <li class="services__item">
            <span class="services__icon">
              <Icon name={service.icon} size={26} />
            </span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="services__closing">
      <p>Pohodlné ubytovanie, praktické služby a&nbsp;všetko na jednom mieste.</p>
      <a class="btn btn--primary" href={site.phoneHref}>
        <Icon name="phone" size={18} />
        <span>Zavolajte nám</span>
      </a>
    </div>
  </div>
</section>

<style>
  .services__list {
    display: grid;
    gap: 1rem;
  }

  .services__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 1rem;
    align-items: center;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .services__icon {
    grid-row: 1 / span 2;
    display: inline-grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 14px;
    background: var(--color-accent-soft);
    color: var(--color-accent-text);
  }

  .services__item h3 {
    align-self: end;
    font-size: 1.15rem;
  }

  .services__item p {
    align-self: start;
    margin: 0.15rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .services__closing {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius);
    background: var(--color-dark);
    color: var(--color-on-dark);
  }

  .services__closing p {
    margin: 0;
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .services__closing :focus-visible {
    outline-color: #fff;
  }

  @media (min-width: 760px) {
    .services__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.1rem;
    }

    /* Na širších obrazovkách ikona nad nadpisom */
    .services__item {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      row-gap: 0.35rem;
      align-items: start;
      padding: 1.5rem;
    }

    .services__icon {
      grid-row: auto;
      margin-bottom: 0.65rem;
    }
  }

  @media (min-width: 900px) {
    .services__closing {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2rem;
    }
  }
</style>
