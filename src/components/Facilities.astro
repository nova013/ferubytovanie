---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { site } from '../data/site';
import { photo } from '../data/photos';

const kitchen = photo('kitchen');
const laundry = photo('showers-2');
const sinks = photo('sinks');

const features = [
  { icon: 'wifi', title: 'Wi‑Fi', text: 'Bezdrôtové pripojenie na internet v budove.' },
  { icon: 'parking', title: 'Parkovanie', text: 'Parkovanie priamo pri budove.' },
  { icon: 'washing-machine', title: 'Práčky', text: 'Práčky na pranie vlastného oblečenia.' },
  {
    icon: 'cooking-pot',
    title: 'Spoločné kuchyne',
    text: `${site.facts.kitchens} kuchyne – jedna na každom ubytovacom podlaží.`,
  },
  {
    icon: 'shower',
    title: 'Spoločné kúpeľne',
    text: `${site.facts.bathrooms} kúpeľne so sprchami, umývadlami a toaletami – jedna na každom ubytovacom podlaží.`,
  },
  { icon: 'cctv', title: 'Kamerový systém', text: 'Objekt je monitorovaný kamerovým systémom.' },
] as const;

const floors = ['3. poschodie', '2. poschodie', '1. poschodie', 'Prízemie'];
---

<section class="section facilities" id="vybavenie" aria-labelledby="vybavenie-nadpis">
  <div class="container">
    <SectionHead
      id="vybavenie-nadpis"
      eyebrow="Vybavenie"
      title="Čo máte k dispozícii"
      lead="Všetko uvedené je zahrnuté v cene ubytovania."
    />

    <div class="facilities__layout">
      <ul class="facilities__list">
        {
          features.map((feature) => (
            <li class="facilities__item">
              <span class="facilities__icon">
                <Icon name={feature.icon} size={22} />
              </span>
              <div>
                <h3>{feature.title}</h3>
                <p>{feature.text}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="facilities__media">
        <figure class="img-frame facilities__photo facilities__photo--wide">
          <Picture
            src={kitchen.src}
            alt={kitchen.alt}
            formats={['avif', 'webp']}
            widths={[480, 800, 1200]}
            width={1200}
            sizes="(min-width: 1200px) 600px, (min-width: 900px) 50vw, 100vw"
            loading="lazy"
            decoding="async"
          />
          <figcaption>{kitchen.caption}</figcaption>
        </figure>
        <figure class="img-frame facilities__photo">
          <Picture
            src={laundry.src}
            alt={laundry.alt}
            formats={['avif', 'webp']}
            widths={[360, 560, 800]}
            width={800}
            sizes="(min-width: 1200px) 300px, (min-width: 900px) 25vw, 50vw"
            loading="lazy"
            decoding="async"
          />
          <figcaption>{laundry.caption}</figcaption>
        </figure>
        <figure class="img-frame facilities__photo">
          <Picture
            src={sinks.src}
            alt={sinks.alt}
            formats={['avif', 'webp']}
            widths={[360, 560, 800]}
            width={800}
            sizes="(min-width: 1200px) 300px, (min-width: 900px) 25vw, 50vw"
            loading="lazy"
            decoding="async"
          />
          <figcaption>{sinks.caption}</figcaption>
        </figure>
      </div>
    </div>

    <div class="floors">
      <ul class="floors__stack" aria-label="Podlažia budovy">
        {
          floors.map((floor, index) => (
            <li class:list={['floors__floor', { 'floors__floor--ground': index === floors.length - 1 }]}>
              {floor}
            </li>
          ))
        }
      </ul>
      <div class="floors__text">
        <h3>Rozloženie budovy</h3>
        <p>
          Budova má prízemie a tri poschodia. Na každom ubytovacom podlaží je jedna spoločná
          kuchyňa a jedna spoločná kúpeľňa – spolu {site.facts.kitchens} kuchyne a {site.facts.bathrooms} kúpeľne.
        </p>
        <ul class="floors__legend">
          <li>
            <Icon name="cooking-pot" size={18} />
            <span>{site.facts.kitchens} spoločné kuchyne</span>
          </li>
          <li>
            <Icon name="shower" size={18} />
            <span>{site.facts.bathrooms} spoločné kúpeľne</span>
          </li>
          <li>
            <Icon name="door" size={18} />
            <span>{site.facts.rooms} izieb, {site.facts.beds} lôžok</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .facilities__layout {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .facilities__list {
    display: grid;
    gap: 1.25rem;
  }

  .facilities__item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .facilities__item h3 {
    font-size: 1.05rem;
    margin-bottom: 0.2rem;
  }

  .facilities__item p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .facilities__icon {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 12px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-accent-text);
  }

  .facilities__media {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .facilities__photo {
    margin: 0;
    aspect-ratio: 3 / 4;
  }

  .facilities__photo--wide {
    grid-column: 1 / -1;
    aspect-ratio: 4 / 3;
  }

  .facilities__photo figcaption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    background: rgba(27, 27, 25, 0.72);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    backdrop-filter: blur(4px);
  }

  /* Rozloženie budovy */
  .floors {
    display: grid;
    gap: 1.75rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .floors__stack {
    display: grid;
    gap: 4px;
    max-width: 320px;
  }

  .floors__floor {
    padding: 0.7rem 1rem;
    border-radius: 6px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    font-weight: 700;
    font-size: 0.92rem;
    text-align: center;
    color: var(--color-text);
  }

  .floors__floor--ground {
    background: var(--color-dark);
    border-color: var(--color-dark);
    color: var(--color-on-dark);
  }

  .floors__text h3 {
    margin-bottom: 0.5rem;
  }

  .floors__text p {
    color: var(--color-text-muted);
    max-width: 36rem;
  }

  .floors__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1rem;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .floors__legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .floors__legend svg {
    color: var(--color-accent-text);
  }

  @media (min-width: 640px) {
    .facilities__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 2rem;
    }
  }

  @media (min-width: 700px) {
    .facilities__media {
      gap: 1.1rem;
    }

    .facilities__photo--wide {
      aspect-ratio: 16 / 10;
    }
  }

  @media (min-width: 900px) {
    .facilities__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem 2.5rem;
    }

    /* Kuchyňa na šírku + kúpeľňa s práčkou + umývadlá v jednom rade */
    .facilities__media {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
      grid-auto-rows: clamp(320px, 30vw, 440px);
    }

    .facilities__photo,
    .facilities__photo--wide {
      grid-column: auto;
      aspect-ratio: auto;
      height: 100%;
    }

    .floors {
      grid-template-columns: 300px minmax(0, 1fr);
      align-items: center;
      gap: 3rem;
    }
  }
</style>
