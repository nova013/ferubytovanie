---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<div class="call-bar" role="region" aria-label="Rýchly kontakt">
  <a class="btn btn--primary btn--lg btn--block call-bar__btn" href={site.phoneHref}>
    <Icon name="phone" size={20} />
    <span>Zavolať {site.phoneDisplay}</span>
  </a>
</div>

<style>
  .call-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    padding: 0.65rem var(--gutter) calc(0.65rem + env(safe-area-inset-bottom, 0px));
    background: rgba(246, 245, 241, 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--color-border);
  }

  .call-bar__btn {
    box-shadow: 0 8px 20px -8px rgba(31, 107, 78, 0.8);
  }

  @media (min-width: 900px) {
    .call-bar {
      display: none;
    }
  }
</style>
