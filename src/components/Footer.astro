---
import Logo from './Logo.astro';
import { site, nav } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="#top" class="footer__logo" aria-label={`${site.name} – na začiatok stránky`}>
        <Logo size={34} />
        <span>{site.name}</span>
      </a>
      <p>Praktické a cenovo dostupné ubytovanie v Bratislave – Dúbravke. Už od {site.price.display} za noc a lôžko.</p>
    </div>

    <div class="footer__col">
      <h2 class="footer__title">Kontakt</h2>
      <address class="footer__address">
        <span>{site.address.street}</span>
        <span>{site.address.postalCode} {site.address.city} – {site.address.district}</span>
      </address>
      <a href={site.phoneHref}>{site.phoneDisplay}</a>
      <a href={site.emailHref}>{site.email}</a>
    </div>

    <nav class="footer__col" aria-label="Navigácia v päte stránky">
      <h2 class="footer__title">Na stránke</h2>
      <ul class="footer__nav">
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container footer__bottom">
    <p>
      © <span data-year>{year}</span> {site.name}. Ubytovanie Bratislava – Dúbravka, Polianky 15.
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-dark);
    color: var(--color-on-dark-muted);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.95rem;
  }

  .footer a {
    color: var(--color-on-dark);
    text-decoration: none;
  }

  .footer a:hover {
    text-decoration: underline;
  }

  .footer__grid {
    display: grid;
    gap: 2rem;
    padding-block: 3rem 2rem;
  }

  .footer__brand p {
    max-width: 30rem;
    margin-top: 0.9rem;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .footer__title {
    margin-bottom: 0.75rem;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-on-dark);
  }

  .footer__col {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    justify-items: start;
  }

  .footer__address {
    display: grid;
    font-style: normal;
    color: var(--color-on-dark);
  }

  .footer__nav {
    display: grid;
    gap: 0.35rem;
  }

  .footer__bottom {
    padding-bottom: 1.5rem;
    font-size: 0.85rem;
  }

  .footer__bottom p {
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 720px) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 3rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-year]').forEach((element) => {
    element.textContent = String(new Date().getFullYear());
  });
</script>
