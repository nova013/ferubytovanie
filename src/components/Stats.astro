---
import Icon from './Icon.astro';
import { site } from '../data/site';

const stats = [
  { value: site.price.display, label: 'za noc a lôžko' },
  { value: String(site.facts.rooms), label: 'izieb s 2 – 3 lôžkami' },
  { value: String(site.facts.beds), label: 'lôžok v budove' },
  { value: `${site.facts.kitchens} + ${site.facts.bathrooms}`, label: 'spoločné kuchyne a kúpeľne' },
];

const included = [
  { icon: 'wifi', label: 'Wi‑Fi v cene' },
  { icon: 'parking', label: 'Parkovanie v cene' },
  { icon: 'washing-machine', label: 'Práčky' },
  { icon: 'cctv', label: 'Kamerový systém' },
  { icon: 'map-pin', label: 'Bratislava – Dúbravka' },
] as const;
---

<section class="stats" aria-label="Základné údaje o ubytovaní">
  <div class="container">
    <ul class="stats__list">
      {
        stats.map((item) => (
          <li class="stats__item">
            <span class="stats__value">{item.value}</span>
            <span class="stats__label">{item.label}</span>
          </li>
        ))
      }
    </ul>
    <ul class="stats__included">
      {
        included.map((item) => (
          <li>
            <Icon name={item.icon} size={18} />
            <span>{item.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .stats {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .stats__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1rem;
    padding-block: 2rem;
  }

  .stats__item {
    display: grid;
    gap: 0.15rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-accent);
  }

  .stats__value {
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-text);
  }

  .stats__label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-muted);
    line-height: 1.3;
  }

  .stats__included {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-block: 0 1.75rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .stats__included li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .stats__included svg {
    color: var(--color-accent-text);
  }

  @media (min-width: 720px) {
    .stats__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;
      padding-block: 2.5rem;
    }
  }

  @media (min-width: 1100px) {
    .stats .container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
    }

    .stats__list {
      flex: 1 1 auto;
      gap: 2.5rem;
      padding-block: 2.25rem;
    }

    .stats__included {
      flex: none;
      flex-direction: column;
      gap: 0.35rem;
      padding-block: 1.5rem;
      padding-left: 3rem;
      border-left: 1px solid var(--color-border);
    }
  }
</style>
